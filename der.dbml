/*
	BASE TABLES
*/

Table people {
  id bigint [pk]
  first_name varchar(255)
  second_name varchar(255) [null]
  middle_name varchar(255)
  last_name varchar(255) [null]
  id_prefix char(1)
  id_number varchar(10) [unique]
  address text
  birth_date date
  gender char(1)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table users {
  id bigint [pk]
  people_id bigint [not null, unique]
  phone_number varchar(255) [unique]
  email varchar(255) [unique]
  password varchar(255)
  is_active bool
  email_verified_at timestamp
  phone_verified_at timestamp
  last_login_at timestamp
  remember_token varchar(255)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table password_reset_tokens {
  email varchar(255) [pk]
  token varchar(255)
  created_at timestamp
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint [null]
  ip_address varchar(45)
  user_agent text
  payload text
  last_activity int
}

Table roles {
  id bigint [pk]
  name varchar(50) [unique]
  slug varchar(50) [unique]
  description varchar(255)
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table modules {
  id bigint [pk]
  name varchar(50) [unique]
  slug varchar(50) [unique]
  description varchar(255)
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table permissions {
  id bigint [pk]
  module_id bigint [not null]
  name varchar(50) [unique]
  slug varchar(50) [unique]
  description varchar(255)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table role_users {
  role_id bigint [pk, unique]
  user_id bigint [pk, unique]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table permission_roles {
  permission_id bigint [pk, unique]
  role_id bigint [pk, unique]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table audit_logs {
  id bigint [pk]
  user_id bigint [not null]
  action varchar(100)
  module_id bigint [not null]
  auditable_type varchar(100)
  auditable_id bigint [unique]
  old_values json
  new_values json
  ip_address varchar(45)
  user_agent text
  created_at timestamp
}

/*
	APPLICANT TABLES
*/

Table applicant_profiles {
  id bigint [pk]
  people_id bigint [not null, unique]
  current_curriculum_vitae_id bigint [unique] [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table work_experiences {
  id bigint [pk]
  applicant_profile_id bigint [not null]
  company_name varchar(255)
  position varchar(255)
  start_date date
  end_date date
  is_current bool
  location varchar(255)
  description text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table education_records {
  id bigint [pk]
  applicant_profile_id bigint [not null]
  institution_name varchar(255)
  degree_name varchar(255)
  field_of_study varchar(255)
  start_date date
  end_date date
  description text
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table skills {
  id bigint [pk]
  name varchar(100) [unique]
  slug varchar(100) [unique]
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table applicant_skills {
  skill_id bigint [pk, unique]
  applicant_profile_id bigint [pk, unique]
  level varchar(15)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table documents {
  id bigint [pk]
  people_id bigint [not null]
  document_type varchar(100)
  file_name varchar(255)
  mime_type varchar(255)
  file_path varchar(255)
  file_size varchar(255)
  verification_status varchar(12) // IN REVIEW, REVIEWED, APPROVED, DECLINED
  verified_by bigint [null]
  verified_at timestamp
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

/*
	JOB TABLES
*/

Table areas {
  id bigint [pk]
  name varchar(100)
  code varchar(10) [unique]
  description varchar(255)
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table positions {
  id bigint [pk]
  area_id bigint [not null]
  name varchar(100)
  code varchar(10) [unique]
  description varchar(255)
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table job_categories {
  id bigint [pk]
  name varchar(100) [unique]
  slug varchar(100) [unique]
  description varchar(255)
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table available_jobs {
  id bigint [pk]
  area_id bigint [not null]
  position_id bigint [not null]
  job_category_id bigint [not null]
  created_by bigint [not null]
  title varchar(255)
  description text
  requirements text
  responsibilities text
  employment_type varchar(255)
  vacancies_count int
  is_active bool
  published_at timestamp
  application_deadline timestamp
  closed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table job_requirements {
  id bigint [pk]
  available_job_id bigint [not null]
  requirement_type varchar(100)
  description varchar(255)
  weight int
  is_required bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table job_publications {
  id bigint [pk]
  available_job_id bigint [not null]
  channel varchar(255)
  published_at timestamp
  unpublished_at timestamp [null]
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table job_favorites {
  applicant_profile_id bigint
  available_job_id bigint
  created_at timestamp
  updated_at timestamp

  indexes {
	(applicant_profile_id, available_job_id) [unique, pk]
  }
}

/*
	INTERVIEW TABLES
*/

Table recruitment_statuses {
  id bigint [pk]
  name varchar(100) [unique]
  slug varchar(100) [unique]
  is_initial bool
  is_final bool
  is_active bool
  sort_order varchar(4)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table applications {
  id bigint [pk]
  available_job_id bigint [not null]
  applicant_profile_id bigint [not null]
  current_status_id bigint [not null]
  procedure_stage_id bigint [not null]
  applied_at timestamp
  withdrawn_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
	(available_job_id, applicant_profile_id) [unique]
  }
}

Table application_status_history {
  id bigint [pk]
  application_id bigint [not null]
  from_status_id bigint [not null]
  to_status_id bigint [not null]
  changed_by bigint [not null]
  reason text
  created_at timestamp
  updated_at timestamp
}

Table selection_procedures {
  id bigint [pk]
  name varchar(100)
  description varchar(255)
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table procedure_stages {
  id bigint [pk]
  selection_procedure_id bigint [not null]
  name varchar(100)
  description varchar(255)
  stage_type varchar(20)
  sort_order varchar(4)
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table application_stage_history {
  id bigint [pk]
  application_id bigint [not null]
  procedure_stage_id bigint [not null]
  status varchar(10)
  started_at timestamp
  completed_at timestamp [null]
  completed_by bigint [not null]
  notes text
  created_at timestamp
  updated_at timestamp
}

/*
	HIRING TABLES
*/

Table interviews {
  id bigint [pk]
  application_id bigint [not null]
  procedure_stage_id bigint [null]
  scheduled_by bigint [not null]
  scheduled_at timestamp
  duration_minutes int
  location varchar(255) [null]
  meeting_url varchar(255) [null]
  notes text
  created_at timestamp
  updated_at timestamp
}

Table interview_participants {
  id bigint [pk]
  interview_id bigint [not null]
  user_id bigint [not null]
  role_id bigint [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
	(interview_id, user_id) [unique]
  }
}

Table interview_results {
  id bigint [pk]
  interview_id bigint [unique]
  result varchar(12)
  score int
  comments text
  recorded_by bigint [not null]
  recorded_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table interview_observations {
  id bigint [pk]
  interview_id bigint [unique]
  author_id bigint [not null]
  observation text
  recorded_at timestamp
  created_at timestamp
  updated_at timestamp
}

/*
	FOLLOW-UP TABLES
*/

Table hiring_decisions {
  id bigint [pk]
  application_id bigint [unique]
  decision varchar(20)
  reason varchar(255)
  decided_by bigint [not null]
  decided_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table employees {
  id bigint [pk]
  user_id bigint [unique]
  employee_code varchar(16) [unique]
  hire_date timestamp
  status varchar(20)
  current_position_id bigint [not null]
  current_area_id bigint [not null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table employee_records {
  id bigint [pk]
  employee_id bigint [unique]
  record_type varchar(50) // VACATION, SICK LEAVE, TRAINING, DISCIPLINARY ACTION, PROMOTION, TRANSFER, ABSENCE, TERMINATION, COMPLAINT, PERFORMANCE, OTHER
  record_value json
  status varchar(10) // PENDING, APPROVED, REJECTED, COMPLETED, DISMISSED
  evidence_id bigint [not null]
  created_at timestamp
  updated_at timestamp
}

Table employee_documents {
  id bigint [pk]
  employee_id bigint [not null]
  document_type varchar(100)
  file_name varchar(255)
  file_path varchar(255)
  mime_type varchar(20)
  file_size int
  verification_status varchar(12) // IN REVIEW, REVIEWED, APPROVED, DECLINED
  verified_by bigint [not null]
  verified_at timestamp [null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

/*
	EVALUATION TABLES
*/

Table evaluation_criteria {
  id bigint [pk]
  name varchar(100)
  description varchar(255)
  scale_min float
  scale_max float
  weight float
  is_active bool
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table evaluations {
  id bigint [pk]
  name varchar(100)
  description varchar(255)
  period_start timestamp [null]
  period_end timestamp [null]
  status varchar(10)
  created_by bigint [not null]
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
}

Table evaluation_assignments {
  id bigint [pk]
  evaluation_id bigint [not null]
  employee_id bigint [not null]
  evaluator_id bigint [not null]
  status varchar(10)
  assigned_at timestamp
  assigned_by bigint [not null]
  completed_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
	(evaluation_id, employee_id, evaluator_id) [unique]
  }
}

Table evaluation_results {
  id bigint [pk]
  evaluation_assignment_id bigint [not null]
  evaluation_criteria_id bigint [not null]
  score float
  comment varchar(255)
  created_at timestamp
  updated_at timestamp

  indexes {
	(evaluation_assignment_id, evaluation_criteria_id) [unique]
  }
}

Table evaluation_observations {
  id bigint [pk]
  evaluation_id bigint [not null]
  employee_id bigint [not null]
  observation text
  author_id bigint [not null]
  created_at timestamp
  updated_at timestamp
}

/*
	REPORTS AND ANALYTICS TABLES
*/

Table indicators {
  id bigint [pk]
  name varchar(100) [unique]
  slug varchar(100) [unique]
  description varchar(255)
  formula text
  unit varchar(4)
  is_active bool
  created_at timestamp
  updated_at timestamp
}

Table metrics {
  id bigint [pk]
  indicator_id bigint [not null]
  period_start timestamp [null]
  period_end timestamp [null]
  value float
  dimensions json
  calculated_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table report_templates {
  id bigint [pk]
  name varchar(100)
  description varchar(255)
  definition json
  is_active bool
  created_at timestamp
  updated_at timestamp
}

Table report_runs {
  id bigint [pk]
  report_template_id bigint [not null]
  requested_by bigint [not null]
  parameters json
  status varchar(10)
  file_path varchar(255)
  started_at timestamp [null]
  completed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
}

Table historical_reports {
  id bigint [pk]
  report_type varchar(100)
  period_start date [null]
  period_end date [null]
  snapshot json
  generated_by bigint [not null]
  generated_at timestamp [null]
  created_at timestamp
  updated_at timestamp
}

Table export_configs {
  id bigint [pk]
  name varchar(100)
  format varchar(6)
  max_rows int
  options json
  status varchar(10)
  created_at timestamp
  updated_at timestamp
}

/*
	CONFIGURATION AND BACKUP TABLES
*/

Table system_settings {
  id bigint [pk]
  key varchar(255) [unique]
  value varchar(255)
  value_type varchar(100)
  is_public bool
  created_at timestamp
  updated_at timestamp
}

Table institutional_settings {
  id bigint [pk]
  key varchar(255) [unique]
  value varchar(255)
  value_type varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table module_settings {
  id bigint [pk]
  module_id bigint [not null]
  key varchar(255)
  value varchar(255)
  value_type varchar(100)
  is_active bool
  created_at timestamp
  updated_at timestamp

  indexes {
	(module_id, key) [unique]
  }
}

Table hr_settings {
  id bigint [pk]
  key varchar(255) [unique]
  value varchar(255)
  value_type varchar(100)
  created_at timestamp
  updated_at timestamp
}

Table backup_runs {
  id bigint [pk]
  requested_by bigint [not null]
  type varchar(100)
  status varchar(10)
  file_path varchar(255)
  size_bytes int
  checksum varchar(255)
  started_at timestamp [null]
  completed_at timestamp [null]
  created_at timestamp
  updated_at timestamp
}

Table backup_verifications {
  id bigint [pk]
  backup_run_id bigint [not null]
  verification_type varchar(100)
  status varchar(10)
  details json
  verified_at timestamp
  created_at timestamp
  updated_at timestamp
}

Table restoration_runs {
  id bigint [pk]
  backup_run_id bigint [not null]
  requested_by bigint [not null]
  status varchar(10]
  target_environment varchar(255)
  started_at timestamp [null]
  completed_at timestamp [null]
  details json
  created_at timestamp
  updated_at timestamp
}

/*
	REFERENCES
*/

Ref: users.people_id - people.id
Ref: sessions.user_id > users.id
Ref: role_users.role_id - roles.id
Ref: role_users.user_id - users.id
Ref: modules.id < permissions.module_id
Ref: permission_roles.permission_id - permissions.id
Ref: permission_roles.role_id - roles.id
Ref: audit_logs.user_id > users.id
Ref: audit_logs.module_id > modules.id
Ref: applicant_profiles.people_id - people.id
Ref: work_experiences.applicant_profile_id > applicant_profiles.id
Ref: education_records.applicant_profile_id > applicant_profiles.id
Ref: applicant_skills.applicant_profile_id - applicant_profiles.id
Ref: applicant_skills.skill_id - skills.id
Ref: documents.people_id > people.id
Ref: documents.verified_by >? employees.id
Ref: positions.area_id > areas.id
Ref: available_jobs.area_id > areas.id
Ref: available_jobs.job_category_id > job_categories.id
Ref: available_jobs.position_id > positions.id
Ref: available_jobs.created_by > employees.id
Ref: job_requirements.available_job_id > available_jobs.id
Ref: job_publications.available_job_id > available_jobs.id
Ref: job_favorites.available_job_id > available_jobs.id
Ref: job_favorites.applicant_profile_id > applicant_profiles.id
Ref: applications.applicant_profile_id > applicant_profiles.id
Ref: applications.available_job_id > available_jobs.id
Ref: applications.current_status_id > recruitment_statuses.id
Ref: applications.procedure_stage_id > procedure_stages.id
Ref: application_status_history.application_id > applications.id
Ref: application_status_history.from_status_id > recruitment_statuses.id
Ref: application_status_history.to_status_id > recruitment_statuses.id
Ref: application_status_history.changed_by > employees.id
Ref: procedure_stages.selection_procedure_id > selection_procedures.id
Ref: application_stage_history.application_id > applications.id
Ref: application_stage_history.procedure_stage_id > procedure_stages.id
Ref: application_stage_history.completed_by > employees.id
Ref: interviews.application_id > applications.id
Ref: interviews.procedure_stage_id >? procedure_stages.id
Ref: interviews.scheduled_by > employees.id
Ref: interview_participants.interview_id > interviews.id
Ref: interview_participants.user_id > users.id
Ref: interview_participants.role_id > roles.id
Ref: interview_results.interview_id - interviews.id
Ref: interview_results.recorded_by > employees.id
Ref: interview_observations.interview_id - interviews.id
Ref: interview_observations.author_id > employees.id
Ref: hiring_decisions.application_id - applications.id
Ref: hiring_decisions.decided_by > employees.id
Ref: employees.user_id - users.id
Ref: employees.current_area_id > areas.id
Ref: employees.current_position_id > positions.id
Ref: employee_records.employee_id - employees.id
Ref: employee_records.evidence_id > employee_documents.id
Ref: employee_documents.employee_id > employees.id
Ref: employee_documents.verified_by > employees.id
Ref: evaluations.created_by > employees.id
Ref: evaluation_assignments.evaluation_id - evaluations.id
Ref: evaluation_assignments.employee_id - employees.id
Ref: evaluation_assignments.evaluator_id - employees.id
Ref: evaluation_assignments.assigned_by > employees.id
Ref: evaluation_results.evaluation_assignment_id - evaluation_assignments.id
Ref: evaluation_results.evaluation_criteria_id - evaluation_criteria.id
Ref: evaluation_observations.evaluation_id > evaluations.id
Ref: evaluation_observations.employee_id > employees.id
Ref: evaluation_observations.author_id > employees.id
Ref: metrics.indicator_id > indicators.id
Ref: report_runs.report_template_id > report_templates.id
Ref: report_runs.requested_by > employees.id
Ref: historical_reports.generated_by > employees.id
Ref: module_settings.module_id > modules.id
Ref: backup_runs.requested_by > employees.id
Ref: backup_verifications.backup_run_id > backup_runs.id
Ref: restoration_runs.backup_run_id > backup_runs.id
Ref: restoration_runs.requested_by > employees.id
